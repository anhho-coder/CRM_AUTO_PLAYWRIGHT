// Re-run the automation test cases DEPLOYED (committed/pushed) in a time window.
//
//   Job name: CRM-Rerun-Deployed-ThisWeek   Pipeline -> Script Path: ci/Jenkinsfile.rerun-deployed
//
// Sibling of ci/Jenkinsfile.rerun-weekly-fails, which re-runs what went RED. This one re-runs
// what is NEW: ci/changed-specs-to-spec.js asks git which *.spec.ts files changed since SINCE on
// the checked-out branch, groups them by section, and writes the same rerun/_suites.txt +
// rerun/<Group>.txt contract, so the per-group re-run loop below is the proven one (quoted spec
// BASENAMES passed with DELAYED expansion so a '%', a space or the O12 U+2192 arrow never reaches
// cmd). Results land in TODAY's dated Allure bucket, so the nightly CRM-Allure-Weekly run picks
// them up (latest-per-test).
//
// PURPOSE: a spec is green on the author's machine; this is the first time CI runs it. The
// default scope is GROUPS=preprod - the crm-mig tree (O12_CE_to_O12_CC) is a shared migration
// base with its own teardown rules, so it is opt-in and is SKIPPED (not failed) when the server
// does not answer.
//
// Same agent guards as the section jobs (Jenkinsfile): probe-node pre-prod route gate, long-path
// -safe checkout, Chrome + ffmpeg checks, mid-run VPN watchdog. A failing group is recorded
// (build FAILURE) but does NOT stop the remaining groups (catchError).
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    parameters {
        string(
            name: 'SINCE',
            defaultValue: 'monday',
            description: 'How far back to look for deployed specs. monday (default) = Monday 00:00 of the CURRENT ISO week; or any git --since value ("7 days", "2026-09-14"); or a git ref/sha, which diffs <ref>..HEAD instead.'
        )
        choice(
            name: 'GROUPS',
            choices: ['preprod', 'all', 'mig', 'SalesReport_Performance', 'CRM_Module', 'Leads_Assignment', 'Lead_Merging', 'Investments', 'Contact', 'Sales_Module', 'O12_Mig', 'Other'],
            description: 'Which specs to re-run. preprod (default) = everything except the crm-mig tree. mig = ONLY tests/1.Project_CRM/O12_CE_to_O12_CC (needs crm-mig up). all = both. Or pin one section.'
        )
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: false,
            description: 'Resolve and print the plan (which specs would run, and what was dropped) WITHOUT launching any test. Always use this first after a big week.'
        )
        string(
            name: 'EXTRA_GREP',
            defaultValue: '',
            description: 'Extra Playwright --grep title-regex to ALSO run and merge into this build - for a spec the resolver cannot map. Example: TC\\.Performance\\.1\\.1\\.1\\.3:'
        )
        choice(
            name: 'ROUTE_GATE',
            choices: ['auto', 'failfast', 'retry', 'off'],
            description: 'Pre-prod VPN route pre-flight on the "probe" node (same as the section jobs). auto = retry when unattended else fail-fast.'
        )
        string(
            name: 'ROUTE_GATE_MIN',
            defaultValue: '15',
            description: 'Retry budget in minutes when ROUTE_GATE=retry (or auto -> retry).'
        )
        string(
            name: 'TIMEOUT_MIN',
            defaultValue: '420',
            description: 'Build timeout in minutes for the whole re-run. 420 (7h) sits just under the 540-min backstop and covers ~120 specs at the measured ~3.4 min/spec (W38 deployed 112 pre-prod specs). GROUPS=all (~190 specs = ~11h) does NOT fit - split it by section or raise the backstop.'
        )
        string(
            name: 'MIN_FREE_GB',
            defaultValue: '5',
            description: 'Abort before running when the agent has less than this many GB free on C:. A full C: takes BOTH Jenkins nodes offline mid-run (incident 2026-07-31) - failing fast here is cheaper than losing a 4-hour run.'
        )
    }

    environment {
        CI = 'true'
        PLAYWRIGHT_BROWSERS_PATH = 'C:\\pw-browsers'
        // Same pre-prod DNS workaround as the section jobs (see main Jenkinsfile).
        HOST_RESOLVER_MAP = 'MAP pre-production.nakivo.site 10.220.222.100'
    }

    options {
        timeout(time: 540, unit: 'MINUTES')   // absolute backstop above the param-driven run timeout
        buildDiscarder(logRotator(numToKeepStr: '15'))
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    // Scheduled: Sunday ~07:00. NOTE: the weekend full regression (CRM-WR-*) fires Friday 18:00 and
    // its chunks have run into Sunday evening (e.g. 2026-09-13 19:01), so this build may QUEUE
    // behind them for hours - it takes an executor from the same pool. Move to 'H 21 * * 0' if the
    // overlap hurts. 'H' hashes the exact minute so many jobs don't fire on the same tick. This
    // triggers directive is authoritative for a declarative pipeline - it (re)registers on the
    // first build after the change is on the branch, so fire one build after pushing to arm it.
    triggers {
        cron('H 7 * * 0')
    }

    stages {
        stage('Pre-prod route gate') {
            agent { label 'probe' }
            steps {
                script {
                    def mode = (params.ROUTE_GATE ?: 'auto').trim()
                    if (mode == 'auto') {
                        def unattended = false
                        try {
                            unattended = currentBuild.getBuildCauses().any {
                                def c = (it._class ?: '')
                                c.contains('TimerTrigger') || c.contains('SCMTrigger') || c.contains('UpstreamCause')
                            }
                        } catch (ignored) { unattended = false }
                        mode = unattended ? 'retry' : 'failfast'
                    }
                    if (mode == 'off') {
                        echo 'ROUTE_GATE=off -> skipping the pre-prod route pre-flight.'
                    } else {
                        def budget = 0
                        if (mode == 'retry') {
                            def m = (params.ROUTE_GATE_MIN ?: '15').trim()
                            budget = m.isInteger() ? m.toInteger() : 15
                        }
                        echo "Pre-prod route gate: mode=${mode}, budget=${budget} min - probing 10.220.222.100 on node 'probe'..."
                        def routeUp = {
                            return bat(returnStatus: true,
                                script: 'ping -n 2 10.220.222.100 | findstr /C:"Reply from 10.220.222.100" >nul') == 0
                        }
                        def waited = 0
                        def up = routeUp()
                        while (!up && waited < budget) {
                            echo "  route DOWN (waited ${waited}/${budget} min) - re-probing in 60s..."
                            sleep(time: 60, unit: 'SECONDS')
                            waited++
                            up = routeUp()
                        }
                        if (!up) {
                            error("ABORTED: pre-prod VPN route down (mode=${mode}, waited ${waited} min). Re-run when the route is back.")
                        }
                        echo "Pre-prod route UP" + (waited > 0 ? " after ${waited} min" : "") + " -> proceeding."
                    }
                }
            }
        }

        stage('Checkout (long-path safe)') {
            steps {
                bat 'git config --global core.longpaths true'
                checkout scm
            }
        }

        stage('Disk headroom pre-flight') {
            steps {
                script {
                    def minGb = (params.MIN_FREE_GB ?: '5').isInteger() ? (params.MIN_FREE_GB ?: '5').toInteger() : 5
                    // The comparison is done INSIDE PowerShell and reported through the exit code:
                    // the Groovy sandbox rejects Double.parseDouble (build #1), and parsing the number
                    // on this side buys nothing.
                    def rc = bat(returnStatus: true, script: """@echo off
powershell -NoProfile -Command "\$f=[math]::Round((Get-PSDrive C).Free/1GB,1); Write-Host ('C: free = ' + \$f + ' GB (minimum ${minGb} GB)'); if (\$f -lt ${minGb}) { exit 1 }"
""")
                    if (rc != 0) {
                        error("ABORTED: less than ${minGb} GB free on C: (see the line above). Playwright media fills C: and takes BOTH Jenkins nodes offline mid-run (incident 2026-07-31) - run CRM-Media-Retention-Purge first.")
                    }
                }
            }
        }

        stage('Install dependencies') {
            steps {
                bat 'npm ci'
            }
        }

        stage('Verify Google Chrome present') {
            steps {
                bat 'if exist "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" (echo Chrome present: OK) else (echo ERROR: Google Chrome not found on agent & exit /b 1)'
            }
        }

        stage('Ensure ffmpeg present (for video recording)') {
            steps {
                bat '''@echo off
setlocal enabledelayedexpansion
set "FF=C:\\pw-browsers\\ffmpeg-1011"
if not exist "%FF%\\INSTALLATION_COMPLETE" (
  echo Placing ffmpeg from repo - CDN extraction stalls on this agent
  if not exist "%FF%" mkdir "%FF%"
  copy /Y "ci\\ffmpeg\\ffmpeg-1011\\*" "%FF%"
) else (
  echo ffmpeg already present - skipping copy
)
if not exist "%FF%\\ffmpeg-win64.exe" (echo ERROR: ffmpeg missing after copy & exit /b 1)
set OK=0
for /L %%i in (1,1,15) do (
  if !OK!==0 (
    "%FF%\\ffmpeg-win64.exe" -version >nul 2>&1
    if !errorlevel!==0 (set OK=1& echo ffmpeg executable verified on attempt %%i) else (echo ffmpeg not runnable yet - attempt %%i - waiting for AV scan... & ping -n 4 127.0.0.1 >nul)
  )
)
if !OK!==0 (echo ERROR: ffmpeg present but not executable after retries - add a Windows Defender exclusion for C:\\pw-browsers on the agent & exit /b 1)
echo ffmpeg OK
'''
            }
        }

        stage('Resolve deployed specs') {
            steps {
                script {
                    // Clean stale report/results from any prior build in this persistent workspace
                    // BEFORE resolving, so a DRY_RUN / nothing-deployed build neither records nor
                    // stashes the previous build's artifacts (which would mark it UNSTABLE).
                    bat 'if exist playwright-report rmdir /s /q playwright-report'
                    bat 'if exist test-results rmdir /s /q test-results'
                    bat 'if exist pw-report rmdir /s /q pw-report'
                    bat 'if exist allure-results rmdir /s /q allure-results'

                    def since = (params.SINCE?.trim() ?: 'monday')
                    def groups = (params.GROUPS ?: 'preprod')
                    echo "Resolve: SINCE=${since}  GROUPS=${groups}  (branch checked out by SCM = HEAD)"
                    withEnv(["SINCE=${since}", "SPEC_GROUPS=${groups}", "REF=HEAD"]) {
                        // Writes rerun/_suites.txt + rerun/<Group>.txt and echoes the plan.
                        bat 'node ci\\changed-specs-to-spec.js'
                    }
                }
            }
        }

        stage('Re-run deployed specs') {
            when { expression { return !params.DRY_RUN } }
            steps {
                script {
                    def suitesTxt = ''
                    if (fileExists('rerun/_suites.txt')) { suitesTxt = readFile('rerun/_suites.txt').trim() }
                    if (!suitesTxt) {
                        echo "No specs were deployed in this window (SINCE=${params.SINCE}, GROUPS=${params.GROUPS}) - nothing to do."
                        return
                    }
                    def entries = suitesTxt.split('\\r?\\n').collect { it.trim() }.findAll { it }

                    // Start with clean report/results dirs so the published report is ONLY this run;
                    // allure-playwright APPENDS across the per-group invocations into this one dir.
                    bat 'if exist playwright-report rmdir /s /q playwright-report'
                    bat 'if exist test-results rmdir /s /q test-results'
                    bat 'if exist pw-report rmdir /s /q pw-report'
                    bat 'if exist allure-results rmdir /s /q allure-results'

                    def runTimeout = (params.TIMEOUT_MIN ?: '300').toInteger()
                    def skipped = []
                    // The per-group loop, wrapped as a closure so it can run under the mid-run VPN
                    // watchdog below.
                    def runLoop = {
                        def ran = 0
                        for (e in entries) {
                            def parts = e.split(' ')
                            def group = parts[0]
                            def count = (parts.size() > 1) ? parts[-1] : '?'

                            // crm-mig is a separate server that has answered 502 for long stretches.
                            // An unreachable server and "nothing to run" look identical in a report,
                            // so SKIP the group loudly instead of failing it.
                            if (group == 'O12_Mig') {
                                def migUp = (bat(returnStatus: true, script: 'curl -s -f -o NUL --max-time 20 "https://crm-mig.nakivo.site/"') == 0)
                                if (!migUp) {
                                    echo "SKIPPED ${group} (${count} spec(s)): https://crm-mig.nakivo.site/ did not answer. This is a SKIP, not a pass."
                                    skipped << "${group} (${count} spec(s)) - crm-mig unreachable"
                                    continue
                                }
                                echo "crm-mig reachable -> running ${group}."
                            }

                            def filters = ''
                            if (fileExists("rerun/${group}.txt")) { filters = readFile("rerun/${group}.txt").trim() }
                            if (!filters) { echo "No filters for ${group} - skipping."; continue }
                            ran++
                            env.DID_RERUN = 'true'   // at least one group actually ran -> record junit in post
                            echo "=== Running ${group}: ${count} deployed spec(s) | timeout ${runTimeout}m ==="
                            // Record a group's failures (build -> FAILURE) but keep going so every
                            // group runs in this one build.
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', message: "${group} had failures") {
                                // Filters (double-quoted, regex-escaped spec basenames) are passed via an
                                // env var and read with DELAYED expansion (!FILTERS!) so a '%' in a
                                // filename is NOT re-parsed by cmd. Each quoted basename becomes its own
                                // positional Playwright filter, matched as a regex against the whole file
                                // path - so a spec that moved folders since it was committed is still found.
                                // --retries=1 (as in ci/Jenkinsfile.slow): a brand-new spec that fails
                                // should cost 2x, not the CI default 3x.
                                withEnv(["FILTERS=${filters}"]) {
                                    bat '''@echo off
setlocal enabledelayedexpansion
echo Filters: !FILTERS!
call npx playwright test !FILTERS! --project=chrome-headless --retries=1
'''
                                }
                            }
                        }
                        if (ran == 0) { echo "No group ran (GROUPS=${params.GROUPS})." }
                    }
                    // --- Mid-run pre-prod VPN gate (see main Jenkinsfile) --------------------
                    // Abort (NOT_BUILT) if CRM-Connectivity-Check raises the VPN-down flag mid-run
                    // so the remaining groups are not executed / not marked failed.
                    bat 'if exist .pw_done del /q .pw_done'
                    env.VPN_ABORT = 'false'
                    try {
                        timeout(time: runTimeout, unit: 'MINUTES') {
                            parallel(
                                'playwright': {
                                    try { runLoop() } finally { bat 'echo done> .pw_done' }
                                },
                                'vpn-watchdog': {
                                    while (!fileExists('.pw_done')) {
                                        sleep(time: 60, unit: 'SECONDS')
                                        if (fileExists('.pw_done')) { break }
                                        if (bat(returnStatus: true, script: 'curl -s -f -o NUL "http://10.8.81.44:8080/userContent/vpn-down.flag"') == 0) {
                                            env.VPN_ABORT = 'true'
                                            echo 'VPN-WATCHDOG: pre-prod VPN flag RAISED mid-run - aborting; remaining groups will NOT run (not failed).'
                                            error('pre-prod VPN dropped mid-run')
                                        }
                                    }
                                },
                                failFast: true
                            )
                        }
                    } catch (err) {
                        def flagUp = (bat(returnStatus: true, script: 'curl -s -f -o NUL "http://10.8.81.44:8080/userContent/vpn-down.flag"') == 0)
                        if (env.VPN_ABORT == 'true' || flagUp) {
                            currentBuild.result = 'NOT_BUILT'
                            echo 'Run stopped: pre-prod VPN dropped mid-run. Remaining groups were NOT executed (not failed).'
                        } else {
                            throw err
                        }
                    }
                    if (skipped) {
                        echo "SKIPPED groups in this build: ${skipped.join('; ')}"
                        // Best-effort build label; never let it fail a run that otherwise finished.
                        try { currentBuild.description = 'SKIPPED: ' + skipped.join('; ') }
                        catch (ignored) { echo 'Could not set the build description (sandbox) - the SKIPPED line above is the record.' }
                    }
                }
            }
        }

        stage('Run extra specs (unmapped)') {
            // Runs specs the resolver cannot map (e.g. a spec whose file was renamed in the same
            // window). Appends into the SAME allure-results + dated bucket. Does NOT clean
            // allure-results, so it merges with the re-run above.
            when { expression { return !params.DRY_RUN && (params.EXTRA_GREP?.trim()) } }
            steps {
                script {
                    def grep = params.EXTRA_GREP.trim()
                    def runTimeout = (params.TIMEOUT_MIN ?: '300').toInteger()
                    echo "=== Running EXTRA specs by --grep: ${grep} (timeout ${runTimeout}m) ==="
                    env.DID_RERUN = 'true'
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', message: 'extra --grep specs had failures') {
                        timeout(time: runTimeout, unit: 'MINUTES') {
                            withEnv(["GP=${grep}"]) {
                                bat 'call npx playwright test --grep "%GP%" --project=chrome-headless --retries=1'
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            // Flatten Playwright's timestamped run folder(s) to a fixed 'pw-report' for a direct link.
            powershell '''
              $ErrorActionPreference = 'Stop'
              try {
                if (Test-Path playwright-report) {
                  $latest = Get-ChildItem -LiteralPath playwright-report -Directory | Sort-Object LastWriteTime -Descending | Select-Object -First 1
                  if ($latest) {
                    if (Test-Path pw-report) { Remove-Item -LiteralPath pw-report -Recurse -Force }
                    New-Item -ItemType Directory -Path pw-report | Out-Null
                    Get-ChildItem -LiteralPath $latest.FullName -Force | ForEach-Object {
                      Copy-Item -LiteralPath $_.FullName -Destination pw-report -Recurse -Force
                    }
                    Write-Host "Published Playwright report from $($latest.Name)"
                  } else { Write-Host 'No per-run report folder found to publish.' }
                } else { Write-Host 'No playwright-report directory found.' }
              } catch {
                Write-Host "WARNING: could not flatten Playwright report: $($_.Exception.Message)"
              }
            '''
            publishHTML([
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'pw-report',
                reportFiles: 'index.html',
                reportName: 'Playwright Report'
            ])
            script {
                // Only record test results when specs actually ran. On a DRY_RUN or a
                // nothing-deployed build the junit step would record ZERO results and mark the
                // build UNSTABLE (yellow) even with allowEmptyResults - skip it and keep SUCCESS.
                if (env.DID_RERUN == 'true') {
                    junit testResults: 'playwright-report/**/junit-results.xml', allowEmptyResults: true
                } else {
                    echo 'No specs ran (DRY_RUN, or nothing deployed in the window) - skipping junit so the build stays SUCCESS, not UNSTABLE.'
                }
            }
            archiveArtifacts artifacts: 'playwright-report/**, test-results/**, rerun/**', allowEmptyArchive: true
            // Drop a DATE-stamped copy into the period bucket so the CURRENT week's Allure report
            // unions these results (latest-per-test). As in the rerun jobs we deliberately do NOT
            // stash into C:\\allure\\results\\<JOB> (the Total report's source), to avoid adding a
            // stray "CRM-Rerun-Deployed-ThisWeek" suite there.
            powershell '''
              try {
                $day  = (Get-Date).ToString('yyyy-MM-dd')
                $dest = "C:\\allure\\periods\\results\\$day\\$env:JOB_BASE_NAME\\$env:BUILD_NUMBER"
                if (Test-Path -LiteralPath $dest) { Remove-Item -LiteralPath $dest -Recurse -Force }
                New-Item -ItemType Directory -Path $dest -Force | Out-Null
                if (Test-Path allure-results) {
                  Get-ChildItem -LiteralPath allure-results -Force | ForEach-Object {
                    Copy-Item -LiteralPath $_.FullName -Destination $dest -Recurse -Force
                  }
                  Write-Host "Stashed dated Allure results -> $dest"
                } else { Write-Host 'No allure-results to stash (dated bucket).' }
              } catch {
                Write-Host "WARNING: could not stash dated Allure results: $($_.Exception.Message)"
              }
            '''
        }
        success { echo 'All specs deployed in this window passed in CI.' }
        failure { echo 'Some newly deployed specs failed in CI. Open the Playwright Report and rerun/_summary.txt (archived) to see which spec and which commit brought it in.' }
    }
}
