// Per-PERIOD combined Allure report (frozen snapshot you can look back at).
//
// FOUR jobs share this one Jenkinsfile and differ only by job name (same pattern as the
// section jobs / jobToProject map). Each runs once on a cron AFTER its period ends and
// freezes the just-completed period's report; Jenkins keepAll keeps every build, so the
// next day/month/quarter/year you open the relevant build -> "Allure Report".
//
//   Job name              Scope       Cron (when it freezes the PREVIOUS period)
//   CRM-Allure-Daily      daily       ~05:00 every day      -> yesterday
//   CRM-Allure-Weekly     weekly      ~05:00 every Monday   -> last ISO week (Mon..Sun)
//                                     + ~23:00 EVERY day    -> the IN-PROGRESS week (nightly refresh)
//   CRM-Allure-Monthly    monthly     ~05:00 on the 1st + ~23:00 EVERY day -> in-progress month
//   CRM-Allure-Quarterly  quarterly   ~05:00 on 1 Jan/Apr/Jul/Oct + ~23:00 EVERY day -> in-progress quarter
//   CRM-Allure-Yearly     yearly      ~05:00 on 1 Jan + ~23:00 EVERY day -> in-progress year
//
// All five run in the 05:00 hour; the 'H' in the minute field hashes each job to its own
// fixed minute so they don't all fire at the same instant. Report generation is light
// (no browser), and Jenkins never interrupts a running build -> these queue behind any
// in-progress job and wait for a free executor.
//
// Pipeline -> Script Path: ci/Jenkinsfile.period-allure   (for all five jobs)
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '200'))   // keep plenty of frozen periods
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    // Optional override to (re)generate a SPECIFIC past period instead of the scheduled
    // "previous" one. Leave blank for cron runs. Formats by scope:
    //   daily=yyyy-MM-dd  weekly=yyyy-Www  monthly=yyyy-MM  quarterly=yyyy-Qn  yearly=yyyy
    parameters {
        choice(name: 'VIEW', choices: ['auto', 'previous', 'current'],
               description: 'Which period to show. auto = the live CURRENT period when a section job triggered this build, otherwise the previous completed period. previous = force the last completed period (Quarterly => last quarter, e.g. Q2). current = the in-progress period (e.g. Q3). Ignored when PERIOD is set.')
        string(name: 'PERIOD', defaultValue: '',
               description: 'Optional EXACT period to regenerate (overrides VIEW). daily=2026-06-19, weekly=2026-W25, monthly=2026-06, quarterly=2026-Q2, yearly=2026.')
    }

    // Each job picks up only the cron line that matches its own name. All in the 05:00 hour;
    // 'H' staggers the minute per job so they don't fire simultaneously.
    // The cron is now a safety heartbeat + period roll-over on the 1st (daily/weekly cron still
    // freeze the previous day/week); monthly/quarterly/yearly resolve to the CURRENT period and
    // are kept fresh by the upstream trigger below. The completed period stays reachable as the
    // "Previous" switcher tab (frozen snapshot), so no archival is lost.
    triggers {
        cron(
            env.JOB_BASE_NAME == 'CRM-Allure-Weekly'    ? '''H 5 * * 1
H(0-9) 23 * * *''' :
            env.JOB_BASE_NAME == 'CRM-Allure-Monthly'   ? '''H 5 1 * *
H(0-9) 23 * * *''' :
            env.JOB_BASE_NAME == 'CRM-Allure-Quarterly' ? '''H 5 1 1,4,7,10 *
H(0-9) 23 * * *''' :
            env.JOB_BASE_NAME == 'CRM-Allure-Yearly'    ? '''H 5 1 1 *
H(0-9) 23 * * *''' :
                                                          'H 5 * * *'          // default: daily
        )
        // LIVE refresh: ALL period reports rebuild after any section job finishes and
        // (see Resolve stage) generate the CURRENT period so runs show up same-day. Monthly,
        // Quarterly and Yearly each default to the current period (and embed the previous one
        // behind a switcher), so they must stay live too. The cron lines above are now just a
        // safety heartbeat / period roll-over on the 1st; day-to-day freshness comes from here.
        upstream(
            // The six original section jobs were retired in Aug-2026 (last builds Jul/Aug) and the
            // weekend-regression CHUNK jobs (CRM-WR-*) took over as the jobs that drop the date-stamped
            // buckets (ci/Jenkinsfile.slow), so this list had gone dead and the reports only refreshed
            // on their cron. Any NEW job that runs ci/Jenkinsfile.slow must be added here too.
            upstreamProjects: 'CRM_Investments,CRM_Lead_Merging,CRM_Leads_Assignment,CRM_SalesReport_Perf,CRM_CRM_Module,CRM_O12,CRM-WR-00-Weekend-Regression,CRM-WR-00b-Resume,CRM-WR-01-SalesReport,CRM-WR-02-Contact,CRM-WR-03-SalesModule,CRM-WR-03a-SalesModule-PromoCreation,CRM-WR-03b-SalesModule-ApplyPromo,CRM-WR-03c-SalesModule-Quotations,CRM-WR-04-Investments-2482,CRM-WR-05-Investments-rest,CRM-WR-06-CRMModule-457,CRM-WR-07-CRMModule-2338,CRM-WR-08-CRMModule-4001-464,CRM-WR-09-CRMModule-10601-3523,CRM-WR-10-LeadMerging-CRM1x,CRM-WR-11-LeadMerging-2178-542,CRM-WR-12-LeadMerging-671-9059,CRM-WR-13-LeadMerging-Explor-Manual,CRM-WR-14-LA-Marketing-BDEU,CRM-WR-15-LA-Teams,CRM-WR-16-LA-THD-3-1,CRM-WR-17-LA-THD-3-2-1,CRM-WR-18-LA-THD-3-2-2,CRM-WR-19-LA-THD-3-2-3,CRM-WR-20-O12-UC-A-1-2-3,CRM-WR-21-O12-UC-A-4-to-8,CRM-WR-22-O12-UC-B-1-to-4,CRM-WR-23-O12-UC-B-5-to-8,CRM-WR-24-O12-Chatter-PreSales,CRM-WR-25-O12-Discount-misc,CRM-Rerun-Weekly-Fails,CRM-Rerun-Monthly-Fails,CRM-Run-Weekly-Submitted,CRM_O12_MIG_ReadOnly,CRM_O12_MIG_Smoke,CRM_FixBug_Confirm3x,CRM_Rerun_Skipped_Monthly',
            threshold: hudson.model.Result.FAILURE   // refresh even when some tests failed
        )
    }

    stages {
        stage('Resolve scope from job name') {
            steps {
                script {
                    def jobScope = [
                        'CRM-Allure-Daily'    : 'daily',
                        'CRM-Allure-Weekly'   : 'weekly',
                        'CRM-Allure-Monthly'  : 'monthly',
                        'CRM-Allure-Quarterly': 'quarterly',
                        'CRM-Allure-Yearly'   : 'yearly'
                    ]
                    env.SCOPE = jobScope[env.JOB_BASE_NAME] ?: 'daily'

                    // Decide which period to build. PERIOD (exact) wins; else the VIEW choice;
                    // else 'auto' = live CURRENT when a section job triggered us (UpstreamCause),
                    // otherwise the previous completed period (clean archival snapshot).
                    def upstreamHit = currentBuild.getBuildCauses().any { (it._class ?: '').contains('UpstreamCause') }
                    def view = (params.VIEW ?: 'auto')
                    if (params.PERIOD?.trim())      { env.CURRENT = 'false' }   // explicit period wins
                    else if (view == 'current')     { env.CURRENT = 'true'  }   // force in-progress period
                    else if (view == 'previous')    { env.CURRENT = 'false' }   // force last completed period (e.g. Q2)
                    else if (env.SCOPE in ['monthly', 'quarterly', 'yearly']) { env.CURRENT = 'true' } // auto: calendar-period reports default to the CURRENT period (embed previous behind a switcher)
                    else {
                        // auto: daily/weekly -> live CURRENT on upstream, else the previous
                        // completed period. PLUS a nightly refresh: the section jobs no longer
                        // all sit in the upstream list, so the weekly report went stale between
                        // Monday crons. Any build started from 12:00 on (the 23:00 cron, or a
                        // manual evening run) renders the IN-PROGRESS day/week so that day's
                        // runs show up the same night; the 05:00 cron keeps its job of freezing
                        // the just-completed period as the clean archival snapshot.
                        def eveningRun = false
                        try {
                            def hourOut = bat(returnStdout: true,
                                script: '''@echo off
powershell -NoProfile -Command "(Get-Date).Hour"''').trim()
                            eveningRun = Integer.parseInt(hourOut.readLines().last().trim()) >= 12
                        } catch (err) {
                            echo "Could not read the local hour (${err}) -> falling back to the upstream rule."
                        }
                        env.CURRENT = (upstreamHit || eveningRun) ? 'true' : 'false'
                    }
                    echo "Job '${env.JOB_BASE_NAME}' -> SCOPE=${env.SCOPE}  VIEW=${view}  CURRENT=${env.CURRENT}  PERIOD='${params.PERIOD}'"
                }
            }
        }

        stage('Checkout (long-path safe)') {
            steps {
                bat 'git config --global core.longpaths true'
                checkout scm
            }
        }

        stage('Install deps (allure-commandline)') {
            steps {
                bat 'npm ci'
            }
        }

        stage('Freeze period Allure report') {
            steps {
                script {
                    def periodArg = (params.PERIOD?.trim()) ? " -Period ${params.PERIOD.trim()}" :
                                    (env.CURRENT == 'true' ? ' -Current' : '')
                    bat "powershell -NoProfile -ExecutionPolicy Bypass -File ci\\allure-period-report.ps1 -Scope ${env.SCOPE}${periodArg}"
                }
            }
        }
    }

    post {
        always {
            // The declarative post runs on the pipeline's own agent+workspace (which holds the
            // freshly generated allure-report), so publishHTML/archiveArtifacts work for normal
            // builds. But when a build is SUPERSEDED (disableConcurrentBuilds) or loses its agent
            // mid-run, post runs with NO workspace -> "Required context class hudson.FilePath is
            // missing" and the build flips to FAILURE. A superseded build has nothing to publish
            // anyway, so swallow that case with catchError (keep the build SUCCESS) instead of
            // wrapping in a NEW node{} -- a fresh node gets an EMPTY workspace and would publish a
            // blank report. lastSuccessfulBuild (what the portal links to) then always stays on the
            // last build that really produced a report.
            catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS', message: 'post publish skipped (no workspace / superseded build)') {
                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'allure-report',
                    reportFiles: 'index.html',
                    reportName: 'Allure-Report'
                ])
                // archiveArtifacts removed 2026-08-31: publishHTML(keepAll) already stores an
                // identical copy of allure-report under builds/<n>/htmlreports, so archiving it
                // doubled JENKINS_HOME on C: (10.4 GB of pure duplicate). Nothing reads the
                // artifact copy -- no copyArtifacts anywhere, the portal links htmlreports, and
                // the rerun jobs read the frozen reports from C:llure\periods (junction to E:).
            }
        }
    }
}
