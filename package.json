{
  "name": "crm_auto",
  "version": "1.0.0",
  "description": "TypeScript-based test automation framework using Playwright for Nakivo Partner Portal CRM",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:leads": "playwright test tests/Leads_Assignment --project=chromium",
    "test:performance": "playwright test tests/SalesReport_Performance --project=chromium",
    "test:all-suites": "playwright test tests/Leads_Assignment tests/SalesReport_Performance --project=chromium",
    "test:assign-parallel": "playwright test \"tests/1.Project_CRM/O12_CE_to_O12_CC/UC-A.4-Salesperson-qualifies-lead-to-opportunity/UC-A.4.3.Assign_this_opportunity_to-section\" --project=chromium-headless --workers=4",
    "codegen": "playwright codegen",
    "report": "playwright show-report",
    "clean": "rimraf test-results playwright-report",
    "metrics:anchor": "node scripts/metrics/anchor.js",
    "metrics:report": "node scripts/metrics/aggregate.js && node scripts/metrics/build-report.js",
    "metrics:daily": "node scripts/metrics/run-daily.js",
    "qa-report:collect": "node scripts/qa-report/collect.js",
    "qa-report:render": "node scripts/qa-report/render.js",
    "qa-report": "node scripts/qa-report/collect.js && node scripts/qa-report/render.js"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "crm"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@playwright/test": "^1.56.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.10.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
