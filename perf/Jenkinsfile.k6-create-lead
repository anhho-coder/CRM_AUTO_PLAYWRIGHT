// Jenkins pipeline: k6 CREATE-LEAD scaling load test vs CRM PRE-PRODUCTION (Odoo JSON-RPC).
// Concurrent crm.lead create() at increasing user counts (default 10,30,50,100); every
// created lead is bulk-deleted in teardown by an admin account. Pipeline-from-SCM, branch
// now_code_on_Cursor, Script Path: perf/Jenkinsfile.k6-create-lead. Windows agent.
pipeline {
    agent any

    parameters {
        string(name: 'LEVELS',   defaultValue: '10,30,50,100', description: 'Comma list of concurrency levels (simultaneous users creating a lead), in order.')
        string(name: 'LOOPS',    defaultValue: '1',    description: 'Leads created per user per level.')
        string(name: 'GAP_S',    defaultValue: '30',   description: 'Seconds between bursts (server recovery).')
        string(name: 'BASE_URL', defaultValue: 'https://pre-production.nakivo.site', description: 'Pre-prod base URL (HTTPS).')
        string(name: 'MAP_IP',   defaultValue: '10.220.222.100', description: 'IP the BASE_URL host maps to (mirrors HOST_RESOLVER_MAP). Blank to disable.')
        string(name: 'P95_MS',   defaultValue: '20000', description: 'Per-level create() p95 gate in ms. Default 20000 (20s) reflects the accepted SLA at high concurrency given the intentional sequential lead-assignment/scoring cron. A level FAILS if its p95 exceeds this (or success <= 99%).')
        string(name: 'INFLUX_URL', defaultValue: 'http://10.8.81.44:8086/k6', description: 'InfluxDB v1 URL for the Grafana aggregate report (http://host:8086/<db>). Metrics are tagged build=<build#> + testid=create-lead-scale. Blank = do not stream (HTML report still produced). If set but unreachable, the job skips streaming with a warning and still runs.')
        string(name: 'TEARDOWN_S', defaultValue: '2700', description: 'Cleanup (k6 teardown) ceiling in seconds. Deleting freshly-created records is slow because the sequential assignment/scoring cron locks each new row: measured unlink avg 62.7s / p95 92.4s / max 121.1s, and 190 records at 8 per batch = 24 batches. The old hard-coded 1200s aborted cleanup mid-way (k6 exit 101) even when every load level PASSed. Raise only together with the pipeline timeout below.')
    }

    environment {
        K6_DIR     = 'C:\\tools\\k6'
        REPORT_DIR = 'perf\\k6\\report'
    }

    options {
        timestamps()
        // Wide: teardown may grind through ~190 slow deletes while the assignment cron drains.
        timeout(time: 75, unit: 'MINUTES')
    }

    // Weekly perf trend (Goal 2 on the Grafana dashboard needs more than one build to plot).
    // Saturday evening, STAGGERED: two k6 tests running at once would each become the
    // other's background load on the same pre-prod and every latency number would be junk.
    // CRM-K6-CreateLead-Scale @ 19:50 Sat - ~3min load + up to 45min TEARDOWN_S cleanup -> ends ~20:40
    triggers { cron('50 19 * * 6') }

    stages {
        stage('Checkout') {
            steps {
                bat 'git config --global core.longpaths true'
                checkout scm
            }
        }

        stage('Resolve config') {
            steps {
                script {
                    env.EFF_LEVELS   = (params.LEVELS?.trim()) ?: '10,30,50,100'
                    env.EFF_LOOPS    = (params.LOOPS?.trim()) ?: '1'
                    env.EFF_GAP_S    = (params.GAP_S?.trim()) ?: '30'
                    env.EFF_BASE_URL = (params.BASE_URL?.trim()) ?: 'https://pre-production.nakivo.site'
                    env.EFF_MAP_IP   = (params.MAP_IP != null) ? params.MAP_IP.trim() : '10.220.222.100'
                    env.EFF_P95_MS   = (params.P95_MS?.trim()) ?: '4000'
                    env.EFF_TEARDOWN_S = (params.TEARDOWN_S?.trim()) ?: '2700'
                    env.EFF_RUN_ID   = 'j' + env.BUILD_NUMBER   // unique per build -> unique lead-name prefix for cleanup
                    echo "Effective -> LEVELS=${env.EFF_LEVELS} | LOOPS=${env.EFF_LOOPS} | GAP_S=${env.EFF_GAP_S} | RUN_ID=${env.EFF_RUN_ID} | BASE_URL=${env.EFF_BASE_URL} | MAP_IP=${env.EFF_MAP_IP} | P95_MS=${env.EFF_P95_MS}"

                    // InfluxDB output for the Grafana aggregate report: best-effort (see Jenkinsfile.k6-scale).
                    env.INFLUX_ARGS = ''
                    def influx = (params.INFLUX_URL?.trim()) ?: ''
                    if (influx) {
                        // Parse host/port with plain string ops (no java.util.regex.Matcher kept
                        // across a pipeline step -> avoids CPS NotSerializableException).
                        def hostport = influx.replaceFirst(/^https?:\/\//, '').split('/')[0]
                        def parts = hostport.split(':')
                        def h = parts[0]
                        def p = (parts.length > 1 && parts[1]) ? parts[1] : '8086'
                        def rc = powershell(returnStatus: true, script: "if (Test-NetConnection -ComputerName '${h}' -Port ${p} -InformationLevel Quiet -WarningAction SilentlyContinue) { exit 0 } else { exit 1 }")
                        if (rc == 0) {
                            env.INFLUX_ARGS = "-o influxdb=${influx}"
                            echo "InfluxDB reachable at ${h}:${p} -> streaming metrics (testid=create-lead-scale, build=${env.BUILD_NUMBER})."
                        } else {
                            echo "WARNING: InfluxDB ${influx} unreachable (${h}:${p}); skipping InfluxDB output. HTML report still produced."
                        }
                    }
                }
            }
        }

        stage('Route pre-check (VPN to pre-prod)') {
            steps {
                powershell '''
                    $ip = $env:EFF_MAP_IP
                    if (-not $ip) { try { $ip = ([uri]$env:EFF_BASE_URL).Host } catch { $ip = "" } }
                    if (-not $ip) { $ip = "10.220.222.100" }
                    Write-Host "Probing pre-prod route to ${ip}:443 ..."
                    $ok = Test-NetConnection -ComputerName $ip -Port 443 -InformationLevel Quiet -WarningAction SilentlyContinue
                    if (-not $ok) {
                        Write-Error "ABORTED: pre-prod route down (cannot reach ${ip}:443). Is the VPN up on the agent?"
                        exit 1
                    }
                    Write-Host "Route OK (${ip}:443 reachable)."
                '''
            }
        }

        stage('Ensure k6') {
            steps {
                bat 'powershell -NoProfile -ExecutionPolicy Bypass -File perf\\k6\\ensure-k6.ps1'
            }
        }

        stage('Run k6 create-lead scaling test') {
            steps {
                bat 'if not exist %REPORT_DIR% mkdir %REPORT_DIR%'
                // Admin creds (for teardown unlink) come from a Jenkins credential, NOT from git.
                withCredentials([usernamePassword(credentialsId: 'crm-admin-preprod', usernameVariable: 'ADMIN_USER', passwordVariable: 'ADMIN_PASS')]) {
                    bat '''
                        set "PATH=%K6_DIR%;%PATH%"
                        k6 run ^
                            %INFLUX_ARGS% ^
                            --tag testid=create-lead-scale ^
                            --tag build=%BUILD_NUMBER% ^
                            -e BASE_URL=%EFF_BASE_URL% ^
                            -e MAP_IP=%EFF_MAP_IP% ^
                            -e LEVELS=%EFF_LEVELS% ^
                            -e LOOPS=%EFF_LOOPS% ^
                            -e GAP_S=%EFF_GAP_S% ^
                            -e P95_MS=%EFF_P95_MS% ^
                            -e TEARDOWN_S=%EFF_TEARDOWN_S% ^
                            -e RUN_ID=%EFF_RUN_ID% ^
                            -e ADMIN_USER=%ADMIN_USER% ^
                            -e ADMIN_PASS=%ADMIN_PASS% ^
                            --summary-export=%REPORT_DIR%\\summary-export.json ^
                            --out json=%REPORT_DIR%\\raw-metrics.json ^
                            perf\\k6\\create-lead-scale.js
                    '''
                }
            }
        }
    }

    post {
        always {
            publishHTML([
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'perf/k6/report',
                reportFiles: 'index.html',
                reportName: 'k6-CreateLead-Scale'
            ])
            archiveArtifacts artifacts: 'perf/k6/report/**', allowEmptyArchive: true
        }
    }
}
