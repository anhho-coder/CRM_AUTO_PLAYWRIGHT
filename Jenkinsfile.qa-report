// CRM QA Team — weekly metrics report.
// Collects KPI data from Odoo (nakivo.kpi.database) + worklog data from Jira and
// publishes a two-page self-contained HTML dashboard (Metrics Report +
// Worklog allocation) via the HTML Publisher plugin. Runs daily on a Windows agent.
//
// Point a Jenkins Pipeline job at this file (Pipeline script from SCM ->
// Script Path: Jenkinsfile.qa-report).
//
// Jenkins credentials used (Manage Jenkins -> Credentials):
//   1) "Username with password", id 'odoo-crm-kpi'  username = anh.ho@nakivo.com
//      password = the Odoo 12 RPC password (the value in ~/.claude/mcp-odoo/
//      credentials.json -> hosts.default.password). NOTE: this is the dedicated
//      RPC/API password, which may differ from the interactive web/SSO login.
//   2) "Secret text", id 'jira-crm-qa'  = a Jira Personal Access Token
//      (Jira -> Profile -> Personal Access Tokens) for reading worklogs.
//      To use Basic auth instead, swap the binding below for a usernamePassword
//      credential exposing JIRA_USER / JIRA_PASSWORD.
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    options {
        timeout(time: 180, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    triggers {
        // Daily on weekdays, ~07:00 (Jenkins picks the exact minute via H).
        cron('H 7 * * 1-5')
    }

    environment {
        ODOO_URL = 'https://crm.nakivo.com'
        ODOO_DB  = 'Nakivo01'
        JIRA_URL = 'http://jira.nakivo.com'
        // QA_REPORT_WINDOW_DAYS = '7'   // uncomment to override the rolling window
    }

    stages {
        stage('Install dependencies') {
            steps {
                bat 'npm ci'
            }
        }
        stage('Collect KPI data') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'odoo-crm-kpi',
                        usernameVariable: 'ODOO_USER', passwordVariable: 'ODOO_PASSWORD'),
                    string(credentialsId: 'jira-crm-qa', variable: 'JIRA_TOKEN')
                ]) {
                    // Bounded retry: re-run collect a few times to recover a TRANSIENT
                    // source failure (a brief Odoo/Jira network blip). Capped LOW on
                    // purpose — when a source is genuinely down, retrying can't fix it, and
                    // 20 slow re-collects previously blew the build timeout and ABORTED the
                    // build with NO report (blank page). With a small cap the Render +
                    // publish stages always run, so a report is ALWAYS published (UNSTABLE
                    // if degraded), never blank. The bat is wrapped so a collect crash can't
                    // fail the stage either. Raise maxAttempts only if you also raise the timeout.
                    script {
                        def maxAttempts = 6
                        def st = 'failed'
                        for (int attempt = 1; attempt <= maxAttempts; attempt++) {
                            if (attempt > 1) {
                                echo "Collect attempt ${attempt}/${maxAttempts}: previous run was '${st}', retrying for complete data…"
                                sleep time: 30, unit: 'SECONDS'
                            }
                            try {
                                bat 'node scripts/qa-report/collect.js'
                            } catch (err) {
                                echo "Collect attempt ${attempt} crashed: ${err}"
                            }
                            try { st = readFile(file: 'qa-report-out/data/status.txt').trim() } catch (e) { st = 'failed' }
                            if (st == 'ok') break
                        }
                        echo "Collect data status: ${st}"
                    }
                }
            }
        }
        stage('Render report') {
            steps {
                bat 'node scripts/qa-report/render.js'
            }
        }
        stage('Check data status') {
            steps {
                script {
                    def st = readFile(file: 'qa-report-out/data/status.txt').trim()
                    echo "QA report data status: ${st}"
                    if (st == 'failed') {
                        currentBuild.result = 'FAILURE'   // no data at all -> red
                    } else if (st == 'degraded') {
                        currentBuild.result = 'UNSTABLE'  // some sources failed -> yellow
                    }
                }
            }
        }
    }

    post {
        always {
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'qa-report-out',
                reportFiles: 'index.html',
                reportName: 'CRMQAReport'
            ])
            archiveArtifacts artifacts: 'qa-report-out/**', allowEmptyArchive: true
        }
    }
}
