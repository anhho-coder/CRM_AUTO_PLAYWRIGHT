// CRM QA Team — weekly metrics report.
// Collects KPI data from Odoo (nakivo.kpi.database) + worklog data from Jira and
// publishes a two-page self-contained HTML dashboard (Metrics Report +
// Worklog allocation) via the HTML Publisher plugin. Runs daily on a Windows agent.
//
// Point a Jenkins Pipeline job at this file (Pipeline script from SCM ->
// Script Path: Jenkinsfile.qa-report).
//
// Jenkins credentials used (Manage Jenkins -> Credentials):
//   1) "Username with password", id 'odoo-crm-kpi'  username = anh.ho@nakivo.com
//      password = the Odoo 12 RPC password (the value in ~/.claude/mcp-odoo/
//      credentials.json -> hosts.default.password). NOTE: this is the dedicated
//      RPC/API password, which may differ from the interactive web/SSO login.
//   2) "Secret text", id 'jira-crm-qa'  = a Jira Personal Access Token
//      (Jira -> Profile -> Personal Access Tokens) for reading worklogs.
//      To use Basic auth instead, swap the binding below for a usernamePassword
//      credential exposing JIRA_USER / JIRA_PASSWORD.
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    options {
        timeout(time: 180, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    triggers {
        // Daily on weekdays, ~07:00 (Jenkins picks the exact minute via H).
        cron('H 7 * * 1-5')
    }

    environment {
        ODOO_URL = 'https://crm.nakivo.com'
        ODOO_DB  = 'Nakivo01'
        JIRA_URL = 'http://jira.nakivo.com'
        // Cross-build cache dir, deliberately OUTSIDE the workspace: this job checks out
        // with WipeWorkspace + CleanBeforeCheckout, so the workspace — qa-report-out and
        // its data/ included — is deleted and re-cloned before every build. With the cache
        // inside it, the FIRST collect attempt of every build re-fetched the whole year
        // ("[worklog] full fetch 2026-01-01.."). Within one build the cache did work — on
        // build #114 attempt 1 was full and attempts 2-6 were incremental (1218 cached rows
        // kept) — so this costs the full-vs-incremental difference once per build, not per
        // attempt. Kept outside the workspace, even the first attempt reads only the last
        // WORKLOG_REFRESH_DAYS and the rest comes from cache.
        QA_REPORT_CACHE_DIR = 'E:/jenkins-cache/crm-qa-report'
        // QA_REPORT_WINDOW_DAYS = '7'   // uncomment to override the rolling window
        // Fallback Jira concurrency. Every shard OVERRIDES this with its own budget (the
        // SHARD_JIRA_CONCURRENCY map in the Collect stage below); this value only takes effect if
        // a branch somehow runs without its withEnv. Deliberately low, so a wiring mistake
        // throttles the build instead of flooding Jira with 8 shards x the config default of 8.
        QA_JIRA_CONCURRENCY = '2'
    }

    stages {
        stage('Install dependencies') {
            steps {
                bat 'npm ci'
            }
        }
        stage('Collect KPI data') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'odoo-crm-kpi',
                        usernameVariable: 'ODOO_USER', passwordVariable: 'ODOO_PASSWORD'),
                    string(credentialsId: 'jira-crm-qa', variable: 'JIRA_TOKEN')
                ]) {
                    script {
                        // Run collection shards in parallel. Each shard collects one group of
                        // sources independently (odoo-kpi, jira-dashboard, frd, manual-heavy,
                        // manual-light, support, automation, worklog), writes its own part file,
                        // and has 2 retries to recover transient failures. A shard that fails
                        // after 2 retries is NOT retried again by this loop — parts are the key:
                        // the Merge stage will use LKG (last known good) fallback for any part
                        // that is missing or corrupt, so a report is ALWAYS publishable. This
                        // replaces the old 6x whole-collect retry + snapshot/restore loop (build
                        // #114 lesson: independent parts mean a failed shard never discards the
                        // other 17 sources' good data).
                        //
                        // PER-SHARD JIRA BUDGET. Splitting the budget EVENLY (8 shards x 1) would
                        // keep Jira load at today's 8 in flight and still make the build SLOWER:
                        // the three shards that dominate the runtime all issue one count() per
                        // (day x tester) over ~20 months, and at concurrency 1 each of them takes
                        // roughly 8x longer than it does today — the wall clock would then be that
                        // one crippled shard, not the sum we are trying to escape. The budget is
                        // therefore weighted towards the per-day-count shards:
                        //   manual-heavy  testexec + unique-testexec + executed-per-day
                        //   manual-light  jiraMetrics is per-day too (support tickets per day)
                        //   automation    automation-tc is per (day x tester x metric)
                        //   worklog       per-issue worklog reads, but incremental (~35 days)
                        //   the rest      a handful of per-range counts; they finish early
                        // Peak = 15 in flight, dropping to ~10 once the light shards finish. That
                        // is ~2x today's 8, but sustained for a much SHORTER window and over the
                        // same total number of requests; lib/jira.js already honours 429/Retry-After.
                        // RE-TUNE THIS after the first build: collect.js now logs per-unit seconds,
                        // so the real distribution is in the console instead of being guesswork.
                        // odoo-kpi talks to Odoo, not Jira — its number is irrelevant.
                        def SHARD_JIRA_CONCURRENCY = [
                            'manual-heavy'  : 4,
                            'manual-light'  : 3,
                            'automation'    : 3,
                            'worklog'       : 2,
                            'jira-dashboard': 1,
                            'frd'           : 1,
                            'support'       : 1,
                            'odoo-kpi'      : 1,
                        ]
                        // Source of truth for the group names is config.js SHARDS / registry.js
                        // GROUPS. A group listed here that no longer exists makes collect.js throw
                        // (unitsForGroups rejects an unknown group); a group MISSING here is caught
                        // the other way round — merge.js finds no part for its units and marks them
                        // 'missing', which names them in failed-sources.txt and turns the build
                        // UNSTABLE. Neither mistake can pass silently.
                        def branches = [:]
                        for (g in SHARD_JIRA_CONCURRENCY.keySet()) {
                            def gg = g  // capture the loop var for use in the closure
                            def cc = SHARD_JIRA_CONCURRENCY[gg]
                            branches[gg] = {
                                withEnv(["QA_JIRA_CONCURRENCY=${cc}"]) {
                                    try {
                                        retry(2) {
                                            bat "node scripts/qa-report/collect.js --only=${gg}"
                                        }
                                        echo "Shard '${gg}' collected successfully (jira concurrency ${cc})."
                                    } catch (err) {
                                        echo "Shard '${gg}' failed after 2 retries: ${err.message}"
                                        // Do not rethrow — Merge will handle the missing/corrupt part
                                        // using LKG, and the build still publishes a report.
                                    }
                                }
                            }
                        }
                        parallel branches
                        echo "Collect phase complete (all shards attempted)."
                    }
                }
            }
        }
        stage('Merge parts') {
            steps {
                bat 'node scripts/qa-report/merge.js'
            }
        }
        stage('Render report') {
            steps {
                bat 'node scripts/qa-report/render.js'
            }
        }
        stage('Check data status') {
            steps {
                script {
                    def st = readFile(file: 'qa-report-out/data/status.txt').trim()
                    echo "QA report data status: ${st}"
                    if (st == 'failed') {
                        currentBuild.result = 'FAILURE'   // no data at all -> red
                    } else if (st == 'degraded') {
                        currentBuild.result = 'UNSTABLE'  // some sources failed -> yellow
                    }
                }
            }
        }
    }

    post {
        always {
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'qa-report-out',
                reportFiles: 'index.html',
                reportName: 'CRMQAReport'
            ])
            // 'qa-report-out/**' is recursive, so it already carries data/parts/*.json — the
            // per-shard parts are archived with everything else, which is what makes a failed
            // shard diagnosable after the fact.
            archiveArtifacts artifacts: 'qa-report-out/**', allowEmptyArchive: true
        }
    }
}
