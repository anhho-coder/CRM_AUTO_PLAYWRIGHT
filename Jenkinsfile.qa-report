// CRM QA Team — weekly metrics report.
// Collects KPI data from Odoo (nakivo.kpi.database) + worklog data from Jira and
// publishes a two-page self-contained HTML dashboard (Metrics Report +
// Worklog allocation) via the HTML Publisher plugin. Runs daily on a Windows agent.
//
// Point a Jenkins Pipeline job at this file (Pipeline script from SCM ->
// Script Path: Jenkinsfile.qa-report).
//
// Jenkins credentials used (Manage Jenkins -> Credentials):
//   1) "Username with password", id 'odoo-crm-kpi'  username = anh.ho@nakivo.com
//      password = the Odoo 12 RPC password (the value in ~/.claude/mcp-odoo/
//      credentials.json -> hosts.default.password). NOTE: this is the dedicated
//      RPC/API password, which may differ from the interactive web/SSO login.
//   2) "Secret text", id 'jira-crm-qa'  = a Jira Personal Access Token
//      (Jira -> Profile -> Personal Access Tokens) for reading worklogs.
//      To use Basic auth instead, swap the binding below for a usernamePassword
//      credential exposing JIRA_USER / JIRA_PASSWORD.
pipeline {
    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    options {
        timeout(time: 180, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    triggers {
        // Daily on weekdays, ~07:00 (Jenkins picks the exact minute via H).
        cron('H 7 * * 1-5')
    }

    environment {
        ODOO_URL = 'https://crm.nakivo.com'
        ODOO_DB  = 'Nakivo01'
        JIRA_URL = 'http://jira.nakivo.com'
        // Cross-build cache dir, deliberately OUTSIDE the workspace: this job checks out
        // with WipeWorkspace + CleanBeforeCheckout, so the workspace — qa-report-out and
        // its data/ included — is deleted and re-cloned before every build. With the cache
        // inside it, the FIRST collect attempt of every build re-fetched the whole year
        // ("[worklog] full fetch 2026-01-01.."). Within one build the cache did work — on
        // build #114 attempt 1 was full and attempts 2-6 were incremental (1218 cached rows
        // kept) — so this costs the full-vs-incremental difference once per build, not per
        // attempt. Kept outside the workspace, even the first attempt reads only the last
        // WORKLOG_REFRESH_DAYS and the rest comes from cache.
        QA_REPORT_CACHE_DIR = 'E:/jenkins-cache/crm-qa-report'
        // QA_REPORT_WINDOW_DAYS = '7'   // uncomment to override the rolling window
    }

    stages {
        stage('Install dependencies') {
            steps {
                bat 'npm ci'
            }
        }
        stage('Collect KPI data') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'odoo-crm-kpi',
                        usernameVariable: 'ODOO_USER', passwordVariable: 'ODOO_PASSWORD'),
                    string(credentialsId: 'jira-crm-qa', variable: 'JIRA_TOKEN')
                ]) {
                    // Bounded retry: re-run collect a few times to recover a TRANSIENT
                    // source failure (a brief Odoo/Jira network blip). Capped LOW on
                    // purpose — when a source is genuinely down, retrying can't fix it, and
                    // 20 slow re-collects previously blew the build timeout and ABORTED the
                    // build with NO report (blank page). With a small cap the Render +
                    // publish stages always run, so a report is ALWAYS published (UNSTABLE
                    // if degraded), never blank. The bat is wrapped so a collect crash can't
                    // fail the stage either. Raise maxAttempts only if you also raise the timeout.
                    script {
                        // Keep the BEST attempt, not the LAST one. Every collect run overwrites
                        // qa-report-out/data/, so this loop used to publish whatever the final
                        // attempt happened to leave behind. On build #114 that discarded five
                        // good attempts in favour of a sixth that had lost jiraAutomationTc to a
                        // transient Jira 400 — and the Automation cards silently disappeared from
                        // the report, which reads as "the metric was never built".
                        // collect.js now writes failed-sources.txt; we snapshot latest.json +
                        // status.txt after any attempt that beats the best so far, and restore
                        // that snapshot before Render. worklog-cache.json is NOT snapshotted: it
                        // is a cross-build cache (and now lives outside the workspace), not report data.
                        def maxAttempts = 6
                        def st = 'failed'
                        def bestFailed = 100000
                        def bestSt = 'failed'
                        def bestAttempt = 0
                        for (int attempt = 1; attempt <= maxAttempts; attempt++) {
                            if (attempt > 1) {
                                echo "Collect attempt ${attempt}/${maxAttempts}: previous run was '${st}', retrying for complete data…"
                                sleep time: 30, unit: 'SECONDS'
                            }
                            try {
                                bat 'node scripts/qa-report/collect.js'
                            } catch (err) {
                                echo "Collect attempt ${attempt} crashed: ${err}"
                            }
                            try { st = readFile(file: 'qa-report-out/data/status.txt').trim() } catch (e) { st = 'failed' }
                            // 99999 = "could not tell"; it still ranks below any real count, so an
                            // unreadable attempt never beats a readable one but does beat nothing.
                            def failed = 99999
                            try {
                                def f = readFile(file: 'qa-report-out/data/failed-sources.txt').trim()
                                failed = f ? f.split(',').length : 0
                            } catch (e) { failed = 99999 }
                            echo "Collect attempt ${attempt}: status=${st}, failed sources=${failed == 99999 ? 'unknown' : failed}"
                            if (failed < bestFailed) {
                                // Only count it as the new best if the snapshot actually succeeded,
                                // otherwise a crashed attempt could leave us with nothing to restore.
                                try {
                                    writeFile file: 'collect-best/latest.json', encoding: 'UTF-8',
                                        text: readFile(file: 'qa-report-out/data/latest.json', encoding: 'UTF-8')
                                    writeFile file: 'collect-best/status.txt', encoding: 'UTF-8',
                                        text: readFile(file: 'qa-report-out/data/status.txt', encoding: 'UTF-8')
                                    bestFailed = failed; bestSt = st; bestAttempt = attempt
                                    echo "Collect attempt ${attempt} is the best so far (${failed == 99999 ? 'unknown' : failed} failed source(s)) — snapshotted."
                                } catch (e) {
                                    echo "Collect attempt ${attempt}: snapshot failed (${e.message}); keeping the previous best."
                                }
                            }
                            if (st == 'ok') break
                        }
                        if (bestAttempt > 0) {
                            try {
                                writeFile file: 'qa-report-out/data/latest.json', encoding: 'UTF-8',
                                    text: readFile(file: 'collect-best/latest.json', encoding: 'UTF-8')
                                writeFile file: 'qa-report-out/data/status.txt', encoding: 'UTF-8',
                                    text: readFile(file: 'collect-best/status.txt', encoding: 'UTF-8')
                                st = bestSt
                                echo "Restored attempt #${bestAttempt} (${bestFailed == 99999 ? 'unknown' : bestFailed} failed source(s)) for rendering."
                            } catch (e) {
                                echo "Could not restore the best snapshot (${e.message}); publishing the last attempt instead."
                            }
                        }
                        echo "Collect data status: ${st}"
                    }
                }
            }
        }
        stage('Render report') {
            steps {
                bat 'node scripts/qa-report/render.js'
            }
        }
        stage('Check data status') {
            steps {
                script {
                    def st = readFile(file: 'qa-report-out/data/status.txt').trim()
                    echo "QA report data status: ${st}"
                    if (st == 'failed') {
                        currentBuild.result = 'FAILURE'   // no data at all -> red
                    } else if (st == 'degraded') {
                        currentBuild.result = 'UNSTABLE'  // some sources failed -> yellow
                    }
                }
            }
        }
    }

    post {
        always {
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'qa-report-out',
                reportFiles: 'index.html',
                reportName: 'CRMQAReport'
            ])
            archiveArtifacts artifacts: 'qa-report-out/**', allowEmptyArchive: true
        }
    }
}
